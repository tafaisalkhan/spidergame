# User exclusions: no assets, no json, no keystore files
assets/
**/*.json
*.json
*.keystore
*.jks
*.p12
*.pem
*key.properties*

# Media assets & binaries (images, audio, fonts)
*.png
*.jpg
*.jpeg
*.webp
*.svg
*.wav
*.mp3
*.ogg
*.ttf
*.otf

# Godot engine cache, UIDs & imports
.godot/
.import/
*.import
*.uid

# Dev tests, agent notes & test configs
tests/
config/
PROJECT_STATE.md
*.log

# Build artifacts & Gradle caches
*.apk
*.aab
*.idsig
.gradle/
.ad-compile/
**/build/
android/

# OS & Editor
.DS_Store
Thumbs.db
*.tmp
