# User exclusions: no assets, no json, no keystore files
assets/
**/*.json
*.json
*.keystore
*.jks
*.p12
*.pem
*key.properties*

# Media assets & binaries (images, audio, fonts)
*.png
*.jpg
*.jpeg
*.webp
*.svg
*.wav
*.mp3
*.ogg
*.ttf
*.otf

# Godot engine cache, UIDs & imports
.godot/
.import/
*.import
*.uid

# Dev tests, agent notes & test configs
tests/
config/
PROJECT_STATE.md
*.log

# Build artifacts & Gradle caches
*.apk
*.aab
*.idsig
.gradle/
.ad-compile/
**/build/
android/

# OS & Editor
.DS_Store
Thumbs.db
*.tmp

# Play listing artwork and matching Android launcher icons
!assets/
assets/*
!assets/branding/
assets/branding/*
!assets/branding/launcher_icon_192.png
!assets/branding/launcher_adaptive_foreground_432.png
!assets/branding/launcher_adaptive_background_432.png
!assets/branding/store_icon_512x512.png

