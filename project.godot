; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spider Territory"
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.015, 0.11, 0.09, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/background/splash-spider-territory.png"
config/icon="res://assets/branding/app-icon-spider-territory.png"

[autoload]

SignalHub="*res://scripts/signal_hub.gd"
GameManager="*res://scripts/game_manager.gd"
AppSettings="*res://scripts/app_settings.gd"
AdsManager="*res://scripts/ads_manager.gd"
BillingManager="*res://scripts/billing_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
